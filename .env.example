# Copy this file to .env.local for local development and fill in the values.
# Add the same variables in Vercel → Project → Settings → Environment Variables.
# Never commit real keys. .env.local is git-ignored.
# VITE_ variables are built into the public website; everything else stays on the server.

# Supabase project URL, for the /admin area in the browser (Project Settings → API → Project URL)
VITE_SUPABASE_URL=
# Supabase "anon public" key, for the /admin area in the browser (safe to expose; row-level security protects data)
VITE_SUPABASE_ANON_KEY=
# Supabase project URL again, for the /api/parent-call server function
SUPABASE_URL=
# Supabase "service_role" key: SERVER ONLY, bypasses security rules. Never prefix with VITE_ or share it
SUPABASE_SERVICE_ROLE_KEY=
# Resend API key for the new-request email alert (resend.com → API Keys)
RESEND_API_KEY=
# Who receives the alert email (comma-separate several addresses)
NOTIFY_EMAIL_TO=
# Sender of the alert. Use "WordCompass <onboarding@resend.dev>" until your domain is verified in Resend
NOTIFY_EMAIL_FROM=WordCompass <onboarding@resend.dev>
# Where /api/blog-feed reads posts: a WordPress REST posts endpoint, or an RSS/Atom feed URL
BLOG_FEED_URL=https://transformationalvocabularies.com/wp-json/wp/v2/posts
# The blog's home page (server-side reference)
BLOG_SITE_URL=https://transformationalvocabularies.com/blog/
# The blog's home page, for the "Visit our blog" / "See all posts" buttons on the website
VITE_BLOG_SITE_URL=https://transformationalvocabularies.com/blog/
# The live website's address, no trailing slash. Used to build sitemap.xml and robots.txt
SITE_URL=https://coaching.transformationalvocabularies.com
