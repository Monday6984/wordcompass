# Copy to .env.local for local development (`vercel dev` and the npm scripts read it).
# Add the same variables in Vercel → Project → Settings → Environment Variables
# (Production AND Preview). Never commit real values: .env.local is git-ignored.
#
# [SECRET] = keep private. Only VITE_ variables reach the browser, and nothing secret
# may ever start with VITE_.

# [SECRET] Neon POOLED connection string (host contains "-pooler"), London region
DATABASE_URL=
# [SECRET] Signs sessions and tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# The site's address, used for auth cookies and reset links. Local: http://localhost:3000 · Production: https://coaching.transformationalvocabularies.com · Leave unset for Preview
BETTER_AUTH_URL=http://localhost:3000
# [SECRET] Resend API key: new-request alerts and password-reset emails
RESEND_API_KEY=
# Who receives new-request alerts (comma-separate several addresses)
NOTIFY_EMAIL_TO=
# Sender for all emails. Use "WordCompass <onboarding@resend.dev>" until your domain is verified in Resend
NOTIFY_EMAIL_FROM=WordCompass <onboarding@resend.dev>
# Where /api/blog-feed reads posts: a WordPress REST posts endpoint, or an RSS/Atom feed URL
BLOG_FEED_URL=https://transformationalvocabularies.com/wp-json/wp/v2/posts
# The blog's home page (server side: resolves relative links in the feed)
BLOG_SITE_URL=https://transformationalvocabularies.com/blog/
# The blog's home page for "Visit our blog" buttons (public, safe in the browser)
VITE_BLOG_SITE_URL=https://transformationalvocabularies.com/blog/
# The live site's address, no trailing slash: sitemap.xml, robots.txt, trusted origin, /admin link in alerts
SITE_URL=https://coaching.transformationalvocabularies.com
